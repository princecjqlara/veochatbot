NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Public HTTPS origin used by Messenger media-card buttons (defaults to NEXTAUTH_URL).
PUBLIC_APP_URL=
NEXTAUTH_SECRET=replace-with-a-long-random-secret

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_URL=http://localhost:3000/api/facebook/webhook

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_POOLER_URL_5432=
DATABASE_POOLER_URL_6543=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=~deepseek/deepseek-flash-latest
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_MULTIMODAL_MODEL=google/gemini-3.8-flash
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
# Optional: only needed for private Drive folders. Public “Anyone with the link” folders need no credentials.
# Keep literal \\n characters when storing this on one line, for example: -----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n
GOOGLE_DRIVE_PRIVATE_KEY=
# Alternative to the two values above: the complete service-account JSON on one line.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
CHATBOT_RAG_MATCH_THRESHOLD=0.35

# Telegram group -> chatbot media bridge
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-token
# JSON object: Telegram group/supergroup chat ID -> VeoBot Page UUID
TELEGRAM_MEDIA_ROUTES={"-1001234567890":"00000000-0000-4000-8000-000000000000"}

CRON_SECRET=
