    "src/app/api/campaigns/[campaignId]/send/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/pages/[pageId]/contacts/tracked-bulk-message/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/facebook/messages/send/route.ts": {
      "maxDuration": 300
