{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/editor-dispatch", "schedule": "* * * * *" },
    { "path": "/api/cron/inquiry-history", "schedule": "1-59/2 * * * *" },
    { "path": "/api/cron/quotas", "schedule": "1-59/5 * * * *" },
    { "path": "/api/cron/incentives", "schedule": "* * * * *" },
    { "path": "/api/cron/database-health", "schedule": "* * * * *" },
    { "path": "/api/cron/meta-ads-sync", "schedule": "2-59/5 * * * *" },
    { "path": "/api/cron/workspace", "schedule": "* * * * *" },
    { "path": "/api/cron/workspace-events", "schedule": "* * * * *" },
    { "path": "/api/cron/contact-identities", "schedule": "* * * * *" },
    { "path": "/api/cron/contact-profiles", "schedule": "0-58/2 * * * *" },
    {
      "path": "/api/cron/messaging-auto-tag",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/chatbot",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/workspace/route.ts": { "maxDuration": 300 },
    "src/app/api/cron/workspace-events/route.ts": { "maxDuration": 180 },
    "src/app/api/cron/contact-identities/route.ts": { "maxDuration": 60 },
    "src/app/api/cron/contact-profiles/route.ts": { "maxDuration": 300 },
    "src/app/api/pages/[pageId]/contacts/[contactId]/profile/route.ts": { "maxDuration": 120 },
    "src/app/api/cron/messaging-auto-tag/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/chatbot/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/meta-ads-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/facebook/webhook/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/pages/[pageId]/sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/campaign-scheduled/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/campaign-loop/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/follow-up-automations/route.ts": {
      "maxDuration": 300
